{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": [
		"src/main.ts",
		"src/desktop-tray.ts",
		"src/desktop-overlay.ts",
		"src/application-policy.ts",
		"src/preload.cts"
	]
}
